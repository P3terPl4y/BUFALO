# Copy this file to .env.production on the deployment host and set real values.
APP_ENV=production
APP_DEBUG=false
APP_HOST=127.0.0.1
DDOS_MODE=enforce
# Use observe temporarily only when tuning legitimate traffic.
APP_PORT=3000
# Replace with the real public HTTPS origin before startup.
APP_URL=https://bufalo.example.com
# Required: exactly 32 characters for Goravel, unique and generated randomly. The app refuses placeholders.
APP_KEY=replace-with-a-unique-random-secret
# Optional: if omitted, APP_KEY is used for rate-limit key hashing.
RATE_LIMIT_KEY_SECRET=
CSRF_TRUSTED_ORIGINS=https://bufalo.duohnson.com

DB_CONNECTION=postgres
DB_HOST=replace-with-postgres-host
DB_PORT=5432
DB_DATABASE=bufalo
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-a-long-random-password
DB_SSLMODE=require
DB_SCHEMA=public
# Optional PostgreSQL URI/keyword DSN. It overrides DB_HOST/PORT/DATABASE/
# USERNAME/PASSWORD and can list multiple hosts for reconnect-time failover.
# Encode reserved characters in credentials. Example (replace every value):
# DB_DSN=postgres://user:password@primary:5432,standby:5432/bufalo?sslmode=require&connect_timeout=5&target_session_attrs=read-write
DB_POOL_MAX_IDLE_CONNS=4
DB_POOL_MAX_OPEN_CONNS=12
DB_POOL_CONN_MAX_IDLE_SECONDS=300
DB_POOL_CONN_MAX_LIFETIME_SECONDS=1800

REDIS_HOST=replace-with-redis-host
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_DB=0
REDIS_POOL_SIZE=10

# Required for confirmation links. Store SMTP credentials in the host secret manager.
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Replace with a sender address verified by the SMTP provider.
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=BUFALO

# Docker only: separate administrator/migration roles and traffic Redis.
DB_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
DB_MIGRATION_USERNAME=bufalo_migrator
DB_MIGRATION_PASSWORD=replace-with-a-long-random-migration-password
RATE_REDIS_HOST=replace-with-traffic-redis-host
RATE_REDIS_PORT=6379
RATE_REDIS_USERNAME=
RATE_REDIS_PASSWORD=replace-with-a-long-random-traffic-redis-password
RATE_REDIS_DB=0
# Separate internal loopback health listener; default APP_PORT + 1.
APP_HEALTH_PORT=3001
